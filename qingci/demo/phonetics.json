    },
    {
      "id": "ai",
      "symbol": "aɪ",
      "group": "diphthong",
      "title": "双元音",
      "tip": "从低而张开的元音位置滑向 /ɪ/。",
      "note": "起点充分张口，末尾不要另加“衣”。",
      "examples": [
        {
          "word": "my",
          "ipa": "maɪ",
          "meaning": "我的"
        },
        {
          "word": "time",
          "ipa": "taɪm",
          "meaning": "时间"
        },
        {
          "word": "five",
          "ipa": "faɪv",
          "meaning": "五"
        }
