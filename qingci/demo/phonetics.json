{
  "schema": "qingci-phonetics/v1",
  "accent": "en-GB",
  "description": "常见英式教学记法；通过例词听声音，非单独音素录音。不同地区及词典记法可能不同。",
  "lessons": [
    {
      "id": "i-long",
      "symbol": "iː",
      "group": "vowel",
      "title": "长元音",
      "tip": "嘴角轻轻向两侧展开，舌前部抬高。保持同一个声音，不要读成字母 E。",
      "note": "与 /ɪ/ 比较：sheep 和 ship，口型和音质也不同，不只是长短。",
      "examples": [
        {
          "word": "sheep",
          "ipa": "ʃiːp",
          "meaning": "绵羊"
        },
        {
          "word": "see",
          "ipa": "siː",
          "meaning": "看见"
        },
        {
          "word": "green",
          "ipa": "ɡriːn",
          "meaning": "绿色"
        }
      ]
    },
    {
      "id": "i-short",
      "symbol": "ɪ",
      "group": "vowel",
      "title": "短元音",
      "tip": "嘴唇放松，舌前部略抬高，比 /iː/ 更低、更松。",
      "note": "不要把 ship 读成 sheep。",
      "examples": [
        {
          "word": "ship",
          "ipa": "ʃɪp",
          "meaning": "船"
        },
        {
          "word": "fish",
          "ipa": "fɪʃ",
          "meaning": "鱼"
        },
        {
          "word": "sit",
          "ipa": "sɪt",
          "meaning": "坐"
        }
      ]
    },
    {
      "id": "e",
      "symbol": "e",
      "group": "vowel",
      "title": "前元音",
      "tip": "嘴自然张开，舌前部抬起，开口比 /ɪ/ 大。",
      "note": "有的词典用 /ɛ/ 标这个音；这里沿用常见英式教学记法 /e/。",
      "examples": [
        {
          "word": "bed",
          "ipa": "bed",
          "meaning": "床"
        },
        {
          "word": "egg",
          "ipa": "eɡ",
          "meaning": "鸡蛋"
        },
        {
          "word": "red",
          "ipa": "red",
          "meaning": "红色"
        }
      ]
    },
    {
      "id": "ae",
      "symbol": "æ",
      "group": "vowel",
      "title": "前元音",
      "tip": "张口较大，舌前部放低，嘴唇不圆。",
      "note": "比较 bed /e/ 与 bad /æ/，不要都读成汉语“诶”。",
      "examples": [
        {
          "word": "cat",
          "ipa": "kæt",
          "meaning": "猫"
        },
        {
          "word": "bag",
          "ipa": "bæɡ",
          "meaning": "包"
        },
        {
          "word": "apple",
          "ipa": "ˈæpəl",
          "meaning": "苹果"
        }
      ]
    },
    {
      "id": "a-long",
      "symbol": "ɑː",
      "group": "vowel",
      "title": "长元音",
      "tip": "张口，舌头放低并略向后，嘴唇不圆。",
      "note": "本课用非卷舌英式示例；美式 car 通常带 /r/。",
      "examples": [
        {
          "word": "car",
          "ipa": "kɑː",
          "meaning": "汽车"
        },
        {
          "word": "father",
          "ipa": "ˈfɑːðə",
          "meaning": "父亲"
        },
        {
          "word": "park",
          "ipa": "pɑːk",
          "meaning": "公园"
        }
      ]
    },
    {
      "id": "o-short",
      "symbol": "ɒ",
      "group": "vowel",
      "title": "短元音",
      "tip": "嘴张开，舌头低而靠后，嘴唇轻轻收圆。",
      "note": "美式 hot 常用 /ɑ/；本课固定听英式例词。",
      "examples": [
        {
          "word": "hot",
          "ipa": "hɒt",
          "meaning": "热的"
        },
        {
          "word": "dog",
          "ipa": "dɒɡ",
          "meaning": "狗"
        },
        {
          "word": "box",
          "ipa": "bɒks",
          "meaning": "盒子"
        }
      ]
    },
    {
      "id": "o-long",
      "symbol": "ɔː",
      "group": "vowel",
      "title": "长元音",
      "tip": "舌头靠后，嘴唇圆起，开口比 /ɒ/ 小。",
      "note": "不同地区可能合并部分元音；不要把一个口音当成唯一读法。",
      "examples": [
        {
          "word": "door",
          "ipa": "dɔː",
          "meaning": "门"
        },
        {
          "word": "ball",
          "ipa": "bɔːl",
          "meaning": "球"
        },
        {
          "word": "four",
          "ipa": "fɔː",
          "meaning": "四"
        }
      ]
    },
    {
      "id": "u-short",
      "symbol": "ʊ",
      "group": "vowel",
      "title": "短元音",
      "tip": "嘴唇略圆，舌后部抬高但保持放松。",
      "note": "book 的元音不是 food 的 /uː/。",
      "examples": [
        {
          "word": "book",
          "ipa": "bʊk",
          "meaning": "书"
        },
        {
          "word": "good",
          "ipa": "ɡʊd",
          "meaning": "好的"
        },
        {
          "word": "foot",
          "ipa": "fʊt",
          "meaning": "脚"
        }
      ]
    },
    {
      "id": "u-long",
      "symbol": "uː",
      "group": "vowel",
      "title": "长元音",
      "tip": "嘴唇圆起，舌头抬高，声音平稳；现代英音舌位常较靠前。",
      "note": "与 /ʊ/ 比较时也注意舌位，不要只机械拉长。",
      "examples": [
        {
          "word": "food",
          "ipa": "fuːd",
          "meaning": "食物"
        },
        {
          "word": "blue",
          "ipa": "bluː",
          "meaning": "蓝色"
        },
        {
          "word": "school",
          "ipa": "skuːl",
          "meaning": "学校"
        }
      ]
    },
    {
      "id": "uh",
      "symbol": "ʌ",
      "group": "vowel",
      "title": "短元音",
      "tip": "嘴唇放松，嘴稍张开，舌头处于中低位置。",
      "note": "常见于重读音节；不要与非重读的 /ə/ 混淆。",
      "examples": [
        {
          "word": "cup",
          "ipa": "kʌp",
          "meaning": "杯子"
        },
        {
          "word": "sun",
          "ipa": "sʌn",
          "meaning": "太阳"
        },
        {
          "word": "bus",
          "ipa": "bʌs",
          "meaning": "公交车"
        }
      ]
    },
    {
      "id": "er",
      "symbol": "ɜː",
      "group": "vowel",
      "title": "长元音",
      "tip": "嘴唇放松，舌头在口腔中部，英式示例不卷舌。",
      "note": "美式 bird 通常用带卷舌的 /ɝ/；本课例词为英式。",
      "examples": [
        {
          "word": "bird",
          "ipa": "bɜːd",
          "meaning": "鸟"
        },
        {
          "word": "girl",
          "ipa": "ɡɜːl",
          "meaning": "女孩"
        },
        {
          "word": "work",
          "ipa": "wɜːk",
          "meaning": "工作"
        }
      ]
    },
    {
      "id": "schwa",
