          "word": "tour",
          "ipa": "tʊə",
          "meaning": "游览"
        },
        {
          "word": "poor",
          "ipa": "pʊə",
          "meaning": "贫穷的"
        },
        {
          "word": "sure",
          "ipa": "ʃʊə",
          "meaning": "确定的"
        }
