      "examples": [
        {
          "word": "go",
          "ipa": "ɡəʊ",
          "meaning": "去"
        },
        {
          "word": "home",
          "ipa": "həʊm",
          "meaning": "家"
        },
        {
          "word": "no",
          "ipa": "nəʊ",
          "meaning": "不"
        }
      ]
    },
    {
      "id": "au",
      "symbol": "aʊ",
      "group": "diphthong",
      "title": "双元音",
      "tip": "从低而张开的位置滑向 /ʊ/，嘴唇逐渐收圆。",
      "note": "起点和终点之间连续过渡，不分成两个音节。",
      "examples": [
        {
          "word": "now",
          "ipa": "naʊ",
          "meaning": "现在"
        },
        {
          "word": "house",
          "ipa": "haʊs",
          "meaning": "房子"
        },
        {
          "word": "mouth",
          "ipa": "maʊθ",
          "meaning": "嘴"
        }
      ]
