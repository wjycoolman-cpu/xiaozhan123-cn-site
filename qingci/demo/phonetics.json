      "examples": [
        {
          "word": "tea",
          "ipa": "tiː",
          "meaning": "茶"
        },
        {
          "word": "time",
          "ipa": "taɪm",
          "meaning": "时间"
        },
        {
          "word": "cat",
          "ipa": "kæt",
          "meaning": "猫"
        }
      ]
    },
    {
      "id": "d",
      "symbol": "d",
      "group": "consonant",
      "title": "浊辅音",
      "tip": "舌尖抵上齿龈再放开，声带参与振动。",
